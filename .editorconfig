root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing spaces are a hard line break in Markdown
[*.md]
trim_trailing_whitespace = false

# Tabs are not legal YAML indentation
[*.{yml,yaml}]
indent_style = space
indent_size = 2
